{
  "name": "homely",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev -w @homely/server\" \"npm:dev -w @homely/client\"",
    "build": "npm run build -w @homely/shared && npm run build -w @homely/server && npm run build -w @homely/client",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint && prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @homely/server",
    "db:seed": "npm run db:seed -w @homely/server",
    "db:studio": "npm run db:studio -w @homely/server",
    "lint:fix": "oxlint --fix && prettier --write .",
    "e2e": "npm run build && npm run db:seed:test -w @homely/server && playwright test",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,css,html,yml,yaml}": "prettier --write"
  }
}

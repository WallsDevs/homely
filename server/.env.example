NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=false
DATABASE_URL=postgresql://homely:homely@localhost:5433/homely
DATABASE_URL_TEST=postgresql://homely:homely@localhost:5433/homely_test
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
LOG_LEVEL=debug
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# Registro de cuentas nuevas (true para abrirlo). Cerrado: solo entran las cuentas existentes.
REGISTRATION_ENABLED=false
